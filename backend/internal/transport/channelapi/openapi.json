{
  "openapi": "3.1.0",
  "info": {
    "title": "Quicc POS channel API",
    "version": "1.0.0",
    "description": "main's ports for every sales channel (main 3.0). A channel — the web storefront, the call center, a counter POS terminal, a vendor feed — is an adapter: it holds no business rules and asks main for the menu, prices, store status, orders and tracking. Each channel belongs to one store and authenticates with its own bearer key (qch_…, issued in main's admin UI). Every error is {error, code}; branch on code."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "channelKey": []
    }
  ],
  "paths": {
    "/channel/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Who am I: the channel behind this key and its store",
        "responses": {
          "200": {
            "description": "The channel and its store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/channel/v1/menu": {
      "get": {
        "operationId": "getMenu",
        "summary": "The channel's menu: its view of the store's menu bank",
        "description": "Every item is anchored to bank item ids (anchor.item_ids) — an order names those. Prices are final for this channel (the view's rule and overrides applied), in cents. The ETag is the menu version; send it back as If-None-Match to get a 304 while nothing changed. Needs the menu permission.",
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The menu",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "\"v<version>\""
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Menu"
                }
              }
            }
          },
          "304": {
            "description": "Not changed since the ETag sent"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/channel/v1/menu/version": {
      "get": {
        "operationId": "getMenuVersion",
        "summary": "The menu's version — poll this, refetch the menu when it moves",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "A version you hold; the answer says whether the menu changed after it"
          }
        ],
        "responses": {
          "200": {
            "description": "The version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuVersion"
                }
              }
            }
          },
          "400": {
            "description": "since is not a version number",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/channel/v1/store": {
      "get": {
        "operationId": "getStore",
        "summary": "The store's status: open, paused or closed, order types and ready-time estimates, today's hours, sold-out items",
        "description": "accepting = ASAP orders are taken now. When it is false, next_open_at says when they are again (null = unknown: paused until the store unpauses, or open with every order type off). Brygid-style vendor orders are not affected by a pause.",
        "responses": {
          "200": {
            "description": "The status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/channel/v1/store/times": {
      "get": {
        "operationId": "getStoreTimes",
        "summary": "Times an order can be promised for on a date",
        "description": "Every 15 minutes: the kitchen needs the type's ETA after the later of opening, now and the pause's end, and the time must fall before closing. Empty while paused until further notice. The date is the store's local date, today up to scheduling.days_ahead.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "pickup",
                "delivery"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The times",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreTimes"
                }
              }
            }
          },
          "400": {
            "description": "Bad type or a date outside the window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "That order type is off (type_off) or the store takes ASAP orders only (asap_only)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/channel/v1/store/delivery-check": {
      "post": {
        "operationId": "checkDelivery",
        "summary": "Does the store deliver to this address?",
        "description": "Straight-line distance from the store vs its delivery radius (the rule the store's tablet uses). result: inside (deliverable), outside, check (several places match — show candidates and check the picked one), not_found, no_store_location, delivery_off. The address is not stored or logged. Needs the quote permission. 30 checks a minute per channel.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "line1"
                ],
                "properties": {
                  "line1": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "zip": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryCheck"
                }
              }
            }
          },
          "400": {
            "description": "No street line, or neither zip nor city",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "description": "Too many checks (Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The address lookup is down; try again (try_again)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/channel/v1/openapi.json": {
      "get": {
        "operationId": "getSpec",
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "channelKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "The channel's key: Authorization: Bearer qch_…"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, unknown or revoked channel key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "This channel's permissions don't allow it",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "main can't check the key right now (try_again)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "For people"
          },
          "code": {
            "type": "string",
            "description": "Stable, for programs (unauthorized, forbidden, not_found, bad_request, …)"
          }
        },
        "additionalProperties": false
      },
      "Permissions": {
        "type": "object",
        "required": [
          "menu",
          "quote",
          "orders",
          "track",
          "payments"
        ],
        "properties": {
          "menu": {
            "type": "boolean",
            "description": "May read the menu"
          },
          "quote": {
            "type": "boolean",
            "description": "May price a cart"
          },
          "orders": {
            "type": "boolean",
            "description": "May place orders"
          },
          "track": {
            "type": "boolean",
            "description": "May follow its orders"
          },
          "payments": {
            "type": "array",
            "items": {
              "enum": [
                "card",
                "cash"
              ]
            },
            "description": "Payment methods an order through this channel may use"
          }
        },
        "additionalProperties": false
      },
      "Channel": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "web",
              "operator",
              "counter",
              "vendor"
            ]
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "$ref": "#/components/schemas/Permissions"
          }
        },
        "additionalProperties": false
      },
      "Store": {
        "type": "object",
        "required": [
          "tenant_id",
          "location_id",
          "name",
          "timezone"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "location_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "description": "IANA zone, e.g. America/New_York"
          }
        },
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "required": [
          "channel",
          "store"
        ],
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "store": {
            "$ref": "#/components/schemas/Store"
          }
        },
        "additionalProperties": false
      },
      "MenuVersion": {
        "type": "object",
        "required": [
          "version",
          "changed_at"
        ],
        "properties": {
          "version": {
            "type": "integer"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "changed": {
            "type": "boolean",
            "description": "Only with ?since="
          }
        },
        "additionalProperties": false
      },
      "MenuSize": {
        "type": "object",
        "required": [
          "id",
          "name",
          "short"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "e.g. 12 Medium"
          },
          "short": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ItemSize": {
        "type": "object",
        "required": [
          "size_id",
          "name",
          "price_cents"
        ],
        "properties": {
          "size_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "description": "US cents"
          }
        },
        "additionalProperties": false
      },
      "Anchor": {
        "type": "object",
        "required": [
          "item_ids"
        ],
        "properties": {
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "description": "The bank items this is"
          },
          "size_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "OptionPrice": {
        "type": "object",
        "required": [
          "size_id",
          "price_cents"
        ],
        "properties": {
          "size_id": {
            "type": "string",
            "format": "uuid"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "description": "US cents"
          }
        },
        "additionalProperties": false
      },
      "MenuOption": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price_cents",
          "prices",
          "is_default",
          "sold_out"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "description": "Price when the item has no size (or no size price)"
          },
          "prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionPrice"
            },
            "description": "Price on an item of each size"
          },
          "is_default": {
            "type": "boolean",
            "description": "Comes on the item unless removed"
          },
          "sold_out": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "MenuGroup": {
        "type": "object",
        "required": [
          "id",
          "name",
          "required",
          "min_select",
          "max_select",
          "allow_multiple",
          "portions",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "min_select": {
            "type": "integer"
          },
          "max_select": {
            "type": "integer"
          },
          "allow_multiple": {
            "type": "boolean"
          },
          "portions": {
            "type": "boolean",
            "description": "Options may go on a half (left / right) or the whole"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuOption"
            }
          }
        },
        "additionalProperties": false
      },
      "MenuChoice": {
        "type": "object",
        "required": [
          "item_id",
          "name",
          "price_cents",
          "sizes",
          "sold_out"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "description": "US cents"
          },
          "sizes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemSize"
            }
          },
          "sold_out": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "MenuItem": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "photo",
          "anchor",
          "price_cents",
          "sizes",
          "sold_out",
          "modifier_group_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The view item's id (a bank item id, or a view entry's for a merged / added item)"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "anchor": {
            "$ref": "#/components/schemas/Anchor"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "description": "Price when it has no sizes"
          },
          "sizes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemSize"
            }
          },
          "sold_out": {
            "type": "boolean"
          },
          "modifier_group_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The item's modifier groups, in order (each is in the menu's modifier_groups)"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuChoice"
            },
            "description": "A merged item: pick one"
          }
        },
        "additionalProperties": false
      },
      "MenuCategory": {
        "type": "object",
        "required": [
          "key",
          "name",
          "position",
          "items"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        },
        "additionalProperties": false
      },
      "Menu": {
        "type": "object",
        "required": [
          "view",
          "version",
          "currency",
          "sizes",
          "categories",
          "modifier_groups"
        ],
        "properties": {
          "view": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "enum": [
                  "web",
                  "operator",
                  "counter",
                  "vendor"
                ]
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "version": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217, USD"
          },
          "sizes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuSize"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuCategory"
            }
          },
          "modifier_groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuGroup"
            },
            "description": "Every modifier group the menu's items use, once"
          }
        },
        "additionalProperties": false
      },
      "HoursRange": {
        "type": "object",
        "required": [
          "open",
          "close"
        ],
        "properties": {
          "open": {
            "type": "string",
            "description": "HH:MM"
          },
          "close": {
            "type": "string",
            "description": "HH:MM; at or before open = past midnight"
          }
        },
        "additionalProperties": false
      },
      "OrderType": {
        "type": "object",
        "required": [
          "enabled",
          "eta_minutes"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "eta_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "radius_m": {
            "type": "integer",
            "description": "Delivery radius, delivery only"
          }
        },
        "additionalProperties": false
      },
      "StoreStatus": {
        "type": "object",
        "required": [
          "store",
          "state",
          "accepting",
          "open_now",
          "hours_set",
          "pause",
          "next_open_at",
          "closes_at",
          "today",
          "order_types",
          "scheduling",
          "sold_out",
          "menu_version"
        ],
        "properties": {
          "store": {
            "type": "object",
            "required": [
              "name",
              "timezone",
              "phone",
              "address_line1",
              "address_line2"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "address_line1": {
                "type": "string"
              },
              "address_line2": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "state": {
            "enum": [
              "open",
              "paused",
              "closed"
            ]
          },
          "accepting": {
            "type": "boolean",
            "description": "ASAP orders are taken now"
          },
          "open_now": {
            "type": "boolean",
            "description": "Inside the opening hours (pause aside)"
          },
          "hours_set": {
            "type": "boolean",
            "description": "false = no hours set: always open"
          },
          "pause": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "since",
                  "until",
                  "note"
                ],
                "properties": {
                  "since": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "until": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "note": {
                    "type": "string",
                    "description": "For customers; may be empty"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "next_open_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "closes_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "today": {
            "type": "object",
            "required": [
              "date",
              "closed",
              "hours",
              "note"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "closed": {
                "type": "boolean"
              },
              "hours": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HoursRange"
                }
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "order_types": {
            "type": "object",
            "required": [
              "pickup",
              "delivery"
            ],
            "properties": {
              "pickup": {
                "$ref": "#/components/schemas/OrderType"
              },
              "delivery": {
                "$ref": "#/components/schemas/OrderType"
              }
            },
            "additionalProperties": false
          },
          "scheduling": {
            "type": "object",
            "required": [
              "days_ahead",
              "slot_minutes"
            ],
            "properties": {
              "days_ahead": {
                "type": "integer",
                "description": "0 = ASAP orders only"
              },
              "slot_minutes": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "sold_out": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "name",
                "until"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "until": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              },
              "additionalProperties": false
            }
          },
          "menu_version": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "StoreTimes": {
        "type": "object",
        "required": [
          "type",
          "date",
          "slot_minutes",
          "times"
        ],
        "properties": {
          "type": {
            "enum": [
              "pickup",
              "delivery"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "slot_minutes": {
            "type": "integer"
          },
          "times": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "additionalProperties": false
      },
      "DeliveryCheck": {
        "type": "object",
        "required": [
          "deliverable",
          "result",
          "distance_m",
          "radius_m",
          "candidates"
        ],
        "properties": {
          "deliverable": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "inside",
              "outside",
              "check",
              "not_found",
              "no_store_location",
              "delivery_off"
            ]
          },
          "distance_m": {
            "type": [
              "integer",
              "null"
            ]
          },
          "radius_m": {
            "type": "integer"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "line1",
                "city",
                "state",
                "postal_code"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "line1": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "postal_code": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
